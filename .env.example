# Copy to .env and configure your public HTTPS address below.
# Leave generated credentials empty on first startup. Container logs print
# copy/paste-ready assignments; save them in .env and recreate the container.
# To generate VAPID keys manually with Docker, run from the project root:
#   docker compose build
#   docker compose run --rm --no-deps push /usr/local/bin/pushie genkeys
# Alternatively, with Go installed:
#   (cd src && go run . genkeys)
# Copy the printed VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY assignments below.
# VAPID public/private keys must be a matching P-256 pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push-service contact email; replace with your own address.
VAPID_SUBJECT=mailto:admin@example.com

# Distinct random bearer tokens for sending and administration.
# Generate each separately with: openssl rand -hex 32
SEND_TOKEN=
ADMIN_TOKEN=

# One-time setup secret, generated with the other missing credentials.
# To generate manually: openssl rand -hex 32
# Clear after registering the first administrator to disable bootstrap.
BOOTSTRAP_OTP=

# Public browser address, without a trailing slash.
# Passkey hostname and default VAPID contact are derived automatically.
ORIGIN=https://push.example.com

# Local defaults; Docker Compose overrides these for the container.
ADDR=127.0.0.1:8099
DB_PATH=shared-data/webpush.sqlite

# Optional comma-separated proxy CIDRs; leave empty without a trusted proxy.
# Example: TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=
